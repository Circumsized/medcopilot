# ==============================================================================
# Global & Environment Configuration (medcopilot)
# ==============================================================================
# 必须显式设置：development/dev/test/local 才开放本地无鉴权流程；
# production/prod 为识别到的生产；空值或错拼（如 prodction）一律 fail-closed
# （读写 503，即便已配置 ADMIN_API_KEY 也不放行）。详见 api/env_policy.py。
PROJECT_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=human
APP_VERSION=2.0.0
APP_GIT_SHA=unknown
# 日志文件落盘路径（自动轮转）。留空则禁用文件日志，仅输出到控制台。
LOG_FILE=logs/app.log
MOCK_LLM=0

# ==============================================================================
# LLM, OCR, Embedding & Reranker (Default: Local Offline; Explicit Cloud Switch)
# ==============================================================================
LLM_PROVIDER=openai_compatible
# local = offline/mock or localhost; cloud = explicitly permit remote API calls
LLM_MODE=local
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE=1.0
LLM_BACKOFF_CAP=20
LLM_RETRY_DEADLINE=45
ALLOW_MOCK_IN_PRODUCTION=false

# Token 预算与 OCR 裁剪上限
MED_LLM_PROMPT_TOKEN_BUDGET=3500
MED_LLM_EVIDENCE_TOKEN_BUDGET=2200
MED_LLM_CHUNK_TOKEN_CAP=1200
MED_OCR_MAX_LINES=5
MED_OCR_MAX_LINE_CHARS=120

# 药盒 OCR（local = PaddleOCR；cloud = OpenAI 兼容多模态视觉接口）
OCR_PROVIDER=local
OCR_API_BASE=
OCR_API_KEY=
OCR_API_MODEL=
OCR_API_TIMEOUT=30
ALLOW_IMAGE_EGRESS=false

# 文本出网总开关（LLM/Embedding/Reranker 任一使用 cloud 时必须显式设为 true）
ALLOW_TEXT_EGRESS=false

# 百度文心千帆 / 智谱 AI 专有凭据 (可选)
QIANFAN_AK=your_qianfan_ak
QIANFAN_SK=your_qianfan_sk
ZHIPUAI_API_KEY=your_zhipuai_api_key

# 向量数据库、Embedding 与 Reranker
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
RRF_K=60
RERANK_TOP_N=3
RERANK_MAX_LENGTH=512
RERANK_ENABLED=true
ENABLE_CHROMA_DENSE=false
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_DIR=
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_API_TIMEOUT=30
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_PROVIDER=local
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_API_TIMEOUT=30
RERANK_CACHE_DIR=
# 运行期不下载权重；需显式运行 prepare_weights.py 或构建带权重镜像。
MODEL_WEIGHTS_OFFLINE=true
HF_HUB_OFFLINE=1

# ==============================================================================
# Safety Guardrails, Ingestion Validation & Audit Trail
# ==============================================================================
DOSAGE_GATE_MODE=redact
RETRIEVE_CANDIDATE_POOL=20
EVIDENCE_TOP_N=5
SAFETY_RESERVE_SLOTS=2
SAFETY_SECTION_GATE_ENABLED=true
SUFFICIENCY_ENABLED=true
SUFFICIENCY_MIN_DOC_COVERAGE=0.10
SUFFICIENCY_MIN_UNION_COVERAGE=0.20
SUFFICIENCY_DRY_RUN=true
EVIDENCE_FLOOR=0.05
GROUNDEDNESS_THRESHOLD=0.15
MAX_DRUG_LABEL_CHARS=50000
INGEST_VALIDATION_ENABLED=true
INGEST_MIN_RAW_CHARS=30
INGEST_MAX_LINE_CHARS=4000
SAFETY_POLICY_PATH=medcopilot/datasets/policies/safety_policy_v1.json

# 医疗审计 sink（免 PHI 的 JSONL + SHA-256 哈希链）
AUDIT_LOG_PATH=logs/audit.jsonl
AUDIT_RETENTION_DAYS=2190
AUDIT_FSYNC=false
AUDIT_NTP_SERVER=

# ==============================================================================
# API Security, Rate Limiting, Session Store & Corpus Persistence
# ==============================================================================
ADMIN_API_KEY=
CORS_ORIGINS=http://127.0.0.1:7860,http://localhost:7860,http://127.0.0.1:8000,http://localhost:8000
CORS_ALLOW_ALL=false
MED_TRUSTED_HOSTS=*
MED_API_BASE_URL=http://127.0.0.1:8000
MED_API_TIMEOUT_SECONDS=30
MED_SESSION_TTL_SECONDS=1800
MED_SESSION_MAX_ENTRIES=256
MED_RATE_LIMIT_ENABLED=true
MED_RATE_LIMIT_CONSULT_PER_MINUTE=20
MED_RATE_LIMIT_IMAGE_PER_MINUTE=6
MED_RATE_LIMIT_INGEST_PER_MINUTE=10
MED_RATE_LIMIT_REBUILD_PER_HOUR=2
MED_LLM_CONCURRENCY=8
MED_CORPUS_PATH=./data/corpus/documents.jsonl
